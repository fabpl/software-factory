  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.0",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
