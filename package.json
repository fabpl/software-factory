{
  "name": "software-factory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Software factory orientée décision : l'humain spécifie, valide les décisions, valide des preuves.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
