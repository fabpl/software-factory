  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@factory/conventions": "workspace:*",
    "@factory/orchestrator": "workspace:*",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/request-error": "7.1.2",
    "@octokit/rest": "22.0.1",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "simple-git": "4.0.2",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.2",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7"
  }
