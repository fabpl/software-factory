{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Inbox Electron de la Software Factory (SPEC-inbox).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
